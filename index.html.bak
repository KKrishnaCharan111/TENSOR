        <div style="font-size: 11px; font-weight: 900; letter-spacing: 1.5px; color: var(--cyan); text-transform: uppercase;">WHOOP 4.0 · PRAFULL</div>
        <h2 style="font-size: 20px; font-weight: 900; margin-top: 2px;">Health &amp; Recovery Monitor</h2>
      </div>
      <button class="close" onclick="closeBleModal()">×</button>
    </header>

    <div class="mbody" style="display: flex; flex-direction: column; gap: 14px;">
