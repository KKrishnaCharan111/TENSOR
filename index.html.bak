}

function updateWhoopDisplayMetrics() {
  if ($('whoopHeartRateVal')) $('whoopHeartRateVal').textContent = liveBpmValue;
  if ($('whoopHrvVal')) $('whoopHrvVal').textContent = `${liveHrvValue} ms`;
  if ($('whoopRecoveryVal')) $('whoopRecoveryVal').textContent = `${realRecoveryVal}%`;
  if ($('whoopStrainVal')) $('whoopStrainVal').textContent = realStrainVal;
  if ($('whoopSleepVal')) $('whoopSleepVal').textContent = `${realSleepVal}%`;

  // Also update Jawan personal dashboard vitals
  if ($('recoveryVal')) $('recoveryVal').textContent = `${realRecoveryVal}%`;
  if ($('strainVal')) $('strainVal').textContent = realStrainVal;
  if ($('hrvVal')) $('hrvVal').textContent = `${liveHrvValue} ms`;
  if ($('sleepVal')) $('sleepVal').textContent = `7.8`;
  if ($('ekgBpmPill')) $('ekgBpmPill').textContent = `${liveBpmValue} BPM`;
  if ($('ekgLiveVal')) $('ekgLiveVal').textContent = liveBpmValue;
  if ($('wireframeBpmVal')) $('wireframeBpmVal').textContent = liveBpmValue;

  // Update HOME SCREEN Commander WHOOP Card
  if ($('homeWhoopBpm')) $('homeWhoopBpm').textContent = liveBpmValue;
  if ($('homeWhoopRecovery')) $('homeWhoopRecovery').textContent = realRecoveryVal;
  if ($('homeWhoopHrv')) $('homeWhoopHrv').textContent = liveHrvValue;
  if ($('homeWhoopSleep')) $('homeWhoopSleep').textContent = ((realSleepVal / 100) * 8.5).toFixed(1);
  if ($('homeWhoopStrain')) $('homeWhoopStrain').textContent = realStrainVal;
  if ($('homeWhoopSpo2')) $('homeWhoopSpo2').textContent = '98';

  // Dynamic AI Assessment Update for Active User
  updateHomeWhoopAiAnalysis();
}

function updateHomeWhoopAiAnalysis() {
  const aiBox = $('homeWhoopAiAnalysis');
  const tag = $('homeWhoopAiClearanceTag');
  const readinessBadge = $('homeWhoopReadinessTag');
  if (!aiBox) return;

  const hoursSleep = ((realSleepVal / 100) * 8.5).toFixed(1);
  const devName = (bleDevice && bleDevice.name) ? bleDevice.name : TARGET_WHOOP_NAME;

  if (realRecoveryVal >= 67) {
    if (tag) {
      tag.textContent = '✓ Warfront Cleared';
      tag.className = 'tag green';
    }
    if (readinessBadge) {
      readinessBadge.textContent = '🟢 Combat Tier 1';
      readinessBadge.className = 'combat-badge ready';
    }
    aiBox.innerHTML = `<b>Physiological Assessment (${devName}):</b> Parasympathetic equilibrium fully restored with pulse at ${liveBpmValue} BPM and resting HRV at ${liveHrvValue} ms following ${hoursSleep}h restorative sleep. Recovery score is optimal at <b>${realRecoveryVal}%</b> with zero acute hypoxia markers (SpO2 98%). Autonomic tone demonstrates superior neuromuscular reactivity and cardiovascular reserve under continuous WHOOP telemetry. <b>Readiness Verdict:</b> Fully cleared for frontline combat sortie, airborne insertions, and sustained high-tempo command.`;
  } else if (realRecoveryVal >= 40) {
    if (tag) {
      tag.textContent = '⚡ Tactical Reserve';
      tag.className = 'tag amber';
    }
    if (readinessBadge) {
      readinessBadge.textContent = '🟡 Tactical Reserve';
      readinessBadge.className = 'combat-badge reserve';
    }
    aiBox.innerHTML = `<b>Physiological Assessment (${devName}):</b> Moderate autonomic fatigue load detected. Current pulse is ${liveBpmValue} BPM, resting HRV at ${liveHrvValue} ms, and Recovery at <b>${realRecoveryVal}%</b> after ${hoursSleep}h sleep. Autonomic restoration is incomplete. <b>Readiness Verdict:</b> Retain in tactical reserve / secondary echelon. Recommend 90-minute circadian nap and 4-4-4-4 tactical box breathing before heavy kinetic engagement.`;
  } else {
    if (tag) {
      tag.textContent = '⛔ Grounded / Fatigue Rest';
      tag.className = 'tag rose';
    }
    if (readinessBadge) {
      readinessBadge.textContent = '🔴 Combat Fatigue Exempt';
      readinessBadge.className = 'combat-badge exempt';
    }
    aiBox.innerHTML = `<b>Physiological Assessment (${devName}):</b> Acute sympathetic exhaustion alert. Heart rate is ${liveBpmValue} BPM, resting HRV depressed to ${liveHrvValue} ms, and recovery compromised at <b>${realRecoveryVal}%</b>. <b>Readiness Verdict:</b> Strictly grounded from combat sortie to eliminate friendly casualty risk. Mandatory 48-hour recovery cycle with clinical oversight.`;
  }
}

// Honest Bluetooth Connection function
async function connectRealWhoop() {
  const errBox = $('whoopErrorBox');
  const errTitle = $('whoopErrorTitle');
  const errMsg = $('whoopErrorMessage');
  const badge = $('bleTopBtn');
  const txt = $('bleStatusText');
  const statusBadge = $('whoopConnStatusBadge');
  const btn = $('whoopConnectBtn');

  if (errBox) errBox.style.display = 'none';

  // Check if running via file:// protocol
  if (window.location.protocol === 'file:') {
    if (errBox) {
      errTitle.textContent = 'Local Server Mode Required';
      errMsg.innerHTML = `Google Chrome & Windows block Bluetooth on <code>file://</code> paths.<br><br>👉 Click here to switch: <a href="http://localhost:8000/index.html" style="color:#38bdf8;font-weight:900;text-decoration:underline;">Open http://localhost:8000/index.html</a>`;
      errBox.style.display = 'block';
    }
    setBleStatus('failed', 'Did Not Connect');
    return;
  }

  // Check if Web Bluetooth is supported
  if (!navigator.bluetooth) {
    if (errBox) {
      errTitle.textContent = 'Web Bluetooth Not Supported in this Browser';
      errMsg.textContent = 'Please open http://localhost:8000 in Google Chrome or Microsoft Edge on your PC to connect Bluetooth hardware.';
      errBox.style.display = 'block';
    }
    setBleStatus('failed', 'Did Not Connect');
    return;
  }

  try {
    if (btn) btn.textContent = 'Searching for Bluetooth Devices...';
    notify('Scanning for nearby Bluetooth devices... Please select your wearable in the browser prompt.');

    // Universal Bluetooth discovery - Anyone can connect any Bluetooth wearable/device
    const device = await navigator.bluetooth.requestDevice({
      acceptAllDevices: true,
      optionalServices: ['heart_rate', 'battery_service', 'device_information', WHOOP_CUSTOM_UUID]
    });

    bleDevice = device;
    const devName = bleDevice.name || 'Bluetooth Wearable';
    if (btn) btn.textContent = `Connecting to ${devName}...`;

    bleDevice.addEventListener('gattserverdisconnected', onRealWhoopDisconnected);
    bleServer = await bleDevice.gatt.connect();

    // Try Subscribing to Heart Rate Service (0x180D)
    try {
      const hrService = await bleServer.getPrimaryService('heart_rate');
      bleHrChar = await hrService.getCharacteristic('heart_rate_measurement');
      await bleHrChar.startNotifications();
      bleHrChar.addEventListener('characteristicvaluechanged', onRealHeartRatePacket);
    } catch (hrErr) {
      console.warn('Heart rate service note:', hrErr.message);
    }

    // Connected Successfully
    bleConnected = true;
    setBleStatus('connected', devName);
    if (btn) btn.textContent = `Connected: ${devName}`;
    if ($('bleConnectedDeviceTitle')) $('bleConnectedDeviceTitle').textContent = devName;
    if ($('bleTelemetryFooter')) $('bleTelemetryFooter').textContent = `${devName} Telemetry Active`;
    notify(`Connected to ${devName} via Bluetooth!`);
  } catch (err) {
    console.error('Bluetooth connection error:', err);
    bleConnected = false;
    setBleStatus('failed', 'Not Connected');

    if (btn) btn.textContent = 'Connect Any Bluetooth Device (Pair Wearable)';

    if (errBox) {
      errTitle.textContent = 'Bluetooth Pairing Prompt Closed';
      if (err.name === 'NotFoundError') {
        errMsg.innerHTML = `Device pairing dialog was cancelled or no device was selected.<br><br>
<b>To connect:</b><br>
1. Ensure your device's Bluetooth is turned ON.<br>
2. If pairing WHOOP or a smart wearable, ensure pairing mode or "Broadcast Heart Rate" is enabled in its app.<br>
3. Click <b>Scan &amp; Pair Device</b> below.`;
      } else {
        errMsg.textContent = `Bluetooth Notice: ${err.message}`;
      }
      errBox.style.display = 'block';
    }
  }
}

function onRealHeartRatePacket(event) {
  const value = event.target.value;
  const flags = value.getUint8(0);
  const is16Bit = flags & 0x1;
  let bpm = 0;
  if (is16Bit) {
    bpm = value.getUint16(1, true);
  } else {
    bpm = value.getUint8(1);
  }

  liveBpmValue = bpm;
  updateWhoopDisplayMetrics();
  const txt = $('bleStatusText');
  const devName = (bleDevice && bleDevice.name) ? bleDevice.name : 'BLE';
  if (txt) txt.textContent = `${devName}: ${bpm} BPM`;
}

function onRealWhoopDisconnected() {
  bleConnected = false;
  const devName = (bleDevice && bleDevice.name) ? bleDevice.name : 'Device';
  setBleStatus('failed', 'Disconnected');
  notify(`${devName} disconnected from Bluetooth.`);
}

function setBleStatus(status, label) {
  const badge = $('bleTopBtn');
  const txt = $('bleStatusText');
  const statusBadge = $('whoopConnStatusBadge');
  const homeBleName = $('homeWhoopBleName');
  const homeBleDot = $('homeWhoopBleDot');
  const homeBleStatusText = $('homeWhoopBleStatusText');

  const activeName = (bleDevice && bleDevice.name) ? bleDevice.name : TARGET_WHOOP_NAME;

  if (status === 'connected') {
    if (badge) badge.className = 'ble-badge connected';
    if (txt) txt.textContent = `WHOOP: ${liveBpmValue} BPM`;
    if (statusBadge) {
      statusBadge.textContent = '🟢 Connected';
      statusBadge.className = 'tag green';
    }
    if (homeBleName) homeBleName.textContent = activeName;
    if ($('homeTrackerBleDevName')) $('homeTrackerBleDevName').textContent = activeName;
    if (homeBleDot) homeBleDot.style.background = 'var(--primary)';
    if (homeBleStatusText) {
      homeBleStatusText.textContent = 'Online / Synced';
      homeBleStatusText.style.color = 'var(--primary)';
    }
    if ($('homeTrackerRhythmBadge')) {
      $('homeTrackerRhythmBadge').textContent = 'BLE SYNCED';
      $('homeTrackerRhythmBadge').className = 'tag green';
    }
  } else if (status === 'failed') {
    if (badge) badge.className = 'ble-badge failed';
    if (txt) txt.textContent = `WHOOP: ${label}`;
    if (statusBadge) {
      statusBadge.textContent = `🔴 ${label}`;
      statusBadge.className = 'tag rose';
    }
    if (homeBleName) homeBleName.textContent = activeName;
    if ($('homeTrackerBleDevName')) $('homeTrackerBleDevName').textContent = activeName;
    if (homeBleDot) homeBleDot.style.background = 'var(--rose)';
    if (homeBleStatusText) {
      homeBleStatusText.textContent = label || 'Offline';
      homeBleStatusText.style.color = 'var(--rose)';
    }
    if ($('homeTrackerRhythmBadge')) {
      $('homeTrackerRhythmBadge').textContent = 'DISCONNECTED';
      $('homeTrackerRhythmBadge').className = 'tag rose';
    }
  } else {
    if (badge) badge.className = 'ble-badge';
    if (txt) txt.textContent = 'WHOOP: Not Connected';
    if (statusBadge) {
      statusBadge.textContent = '🔴 Not Connected';
      statusBadge.className = 'tag rose';
    }
    if (homeBleName) homeBleName.textContent = TARGET_WHOOP_NAME;
    if ($('homeTrackerBleDevName')) $('homeTrackerBleDevName').textContent = TARGET_WHOOP_NAME;
    if (homeBleDot) homeBleDot.style.background = 'var(--primary)';
    if (homeBleStatusText) {
      homeBleStatusText.textContent = 'Online (Simulated)';
      homeBleStatusText.style.color = 'var(--primary)';
    }
    if ($('homeTrackerRhythmBadge')) {
      $('homeTrackerRhythmBadge').textContent = 'SINUS OK';
      $('homeTrackerRhythmBadge').className = 'tag green';
    }
  }

  updateHomeWhoopAiAnalysis();
}

// Backward compatibility alias
function connectTargetWhoop() { connectRealWhoop(); }
function connectWebBluetooth() { connectRealWhoop(); }
function disconnectBle() {
  if (bleDevice && bleDevice.gatt) bleDevice.gatt.disconnect();
  setBleStatus('disconnected', 'Not Connected');
}


/* --- 4. Complete 365-Day Annual Calendar Engine --- */
const monthNames = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'
];
const monthDaysCount = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

function build365DayCalendar() {
  const container = $('calendar12MGrid');
  if (!container) return;
  container.innerHTML = '';

  let dayOfYear = 1;

  monthNames.forEach((mName, mIdx) => {
    const mBox = document.createElement('div');
    mBox.className = 'month-box';

    const mTitle = document.createElement('div');
    mTitle.className = 'month-title';
    mTitle.innerHTML = `<span>${mName}</span><span style="color:var(--muted);font-size:10px">${monthDaysCount[mIdx]}d</span>`;
    mBox.appendChild(mTitle);

    const dGrid = document.createElement('div');
    dGrid.className = 'days-grid';

    for (let d = 1; d <= monthDaysCount[mIdx]; d++) {
      const cell = document.createElement('div');
      cell.className = 'cal-day-cell';
      cell.textContent = d;

      // Realistic classification across 365 days
      let status = 'optimal';
      let strain = (10 + (d % 5) * 1.2).toFixed(1);
      let hrv = (52 + (d % 7) * 2);
      let note = 'Routine operational duty. Autonomic vitals restored.';

      // Specific fatigue periods (e.g. Monsoon rotation Jun/Jul)
      if (mIdx === 5 || mIdx === 6) {
        if (d % 6 === 0) {
          status = 'alert';
          strain = '17.8';
          hrv = 36;
          note = 'Peak monsoon perimeter load. High fatigue signal detected.';
        } else if (d % 3 === 0) {
          status = 'strain';
          strain = '15.1';
          hrv = 44;
          note = 'Consecutive night shift load. Moderate strain.';
        }
      } else if (d % 7 === 0) {
        status = 'leave';
        strain = '8.2';
        hrv = 64;
        note = 'Approved tactical rest window / Leave roster.';
      } else if (d % 5 === 0 && d > 20) {
        status = 'strain';
        strain = '14.6';
        hrv = 46;
        note = 'Tactical training exercise load.';
      }

      cell.classList.add(`day-${status}`);
      cell.dataset.status = status;
      cell.dataset.date = `${d} ${mName} 2026`;
      cell.dataset.strain = strain;
      cell.dataset.hrv = hrv;
      cell.dataset.note = note;

      cell.onclick = () => inspectCalendarDay(cell.dataset);

      dGrid.appendChild(cell);
      dayOfYear++;
    }

    mBox.appendChild(dGrid);
    container.appendChild(mBox);
  });
}

function inspectCalendarDay(data) {
  $('inspDateLabel').innerHTML = `📅 <b>${data.date}</b> — Strain: <span style="color:var(--amber)">${data.strain}/21</span> · Resting HRV: <span style="color:var(--primary)">${data.hrv} ms</span>`;
  $('inspDetailLabel').textContent = `${data.note} (Non-punitive ethical tracking)`;
  notify(`Inspecting telemetry for ${data.date}`);
}

function filterCalendar(filterType, btn) {
  document.querySelectorAll('.cal-filter-row .filter-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');

  const cells = document.querySelectorAll('.cal-day-cell');
  cells.forEach(c => {
    if (filterType === 'all') {
      c.style.opacity = '1';
    } else if (c.dataset.status === filterType) {
      c.style.opacity = '1';
      c.style.outline = '2px solid #ffffff';
    } else {
      c.style.opacity = '0.15';
      c.style.outline = 'none';
    }
  });
}

function open365Calendar() {
  build365DayCalendar();
  updateWhoopDisplayMetrics();
  $('calendarModal').classList.add('open');
}

function close365Calendar() {
  $('calendarModal').classList.remove('open');
}

/* --- 5. AI WHOOP Telemetry Analysis Engine --- */
function analyzeWhoopWithGemini() {
  const whoopData = {
    heartRate: liveBpmValue,
    hrv: $('hrvVal') ? $('hrvVal').textContent : 57,
    sleepHours: $('sleepVal') ? $('sleepVal').textContent : 6.8,
    sleepDebt: 1.2,
    recoveryScore: $('recoveryVal') ? $('recoveryVal').textContent : '64%',
    dailyStrain: $('strainVal') ? $('strainVal').textContent : 12.4,
    consecutiveDays: 28
  };

  const prompt = `Please perform a clinical & tactical analysis of my live WHOOP 4.0 biometric telemetry:
- Live Pulse: ${whoopData.heartRate} BPM
- Resting HRV Baseline: ${whoopData.hrv} ms
- Recovery Score: ${whoopData.recoveryScore}
- Daily Cardiovascular Strain: ${whoopData.dailyStrain}/21
- Sleep Duration: ${whoopData.sleepHours}h (Sleep Debt: ${whoopData.sleepDebt}h)
- Operational Duty Span: ${whoopData.consecutiveDays} days

Provide:
1. Autonomic Nervous System state (Sympathetic vs Parasympathetic balance)
2. Readiness and physical resilience evaluation
3. Actionable recovery protocol (sleep optimization, 4-4-4-4 box breathing, hydration)
4. Recommended duty shift adjustments for the next 24 hours.`;

  if (!$('geminiDrawer').classList.contains('open')) {
    toggleGeminiDrawer();
  }
  appendGeminiMessage('user', '⚡ [Live WHOOP Telemetry Ingestion] Please analyze my current biometric data and recovery status.');
  callGoogleGeminiAPI(prompt);
}

