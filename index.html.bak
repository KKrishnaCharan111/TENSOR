        <button class="btn primary" onclick="saveGeminiKey()">Save Key</button>
      </div>
    </div>
  </section>
</div>

<!-- ⚡ EMERGENCY COMBAT DEPLOYMENT SORTIE MODAL -->
<div id="emergencyDeployModal" class="backdrop">
  <section class="modal" style="width:min(760px, 96vw);max-height:90vh;display:flex;flex-direction:column;">
    <header class="mhead" style="background:color-mix(in srgb, var(--rose) 12%, var(--card));border-bottom:1px solid color-mix(in srgb, var(--rose) 40%, var(--line));">
      <div>
        <div style="display:flex;align-items:center;gap:8px;">
          <span class="tag rose" style="font-weight:900;">⚡ RAPID EMERGENCY SORTIE</span>
          <span class="tag gold" style="font-weight:900;">9 PARA BATTALION</span>
        </div>
        <h2 style="margin-top:6px;font-size:18px;display:flex;align-items:center;gap:8px;">
          Instant Pre-Battle Combat Deployment Generator
        </h2>
        <p style="margin:0;">Physiological triage via continuous WHOOP telemetry · Auto-excludes fatigued jawans to guarantee mission readiness.</p>
      </div>
      <button class="close" onclick="closeEmergencyDeployModal()">×</button>
    </header>

    <div class="mbody" style="overflow-y:auto;flex:1;display:flex;flex-direction:column;gap:16px;">
      <!-- Mission Team Size Selector -->
      <div style="background:var(--card2);border:1px solid var(--line);border-radius:10px;padding:14px;">
        <div style="font-size:11px;font-weight:900;color:var(--muted);text-transform:uppercase;margin-bottom:8px;">
          Select Emergency Sortie Profile:
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="btn primary" onclick="setDeployTeamSize(8, this)" id="btnSize8">
            ⚡ Squad Strike (8 Jawans)
          </button>
          <button class="btn" onclick="setDeployTeamSize(12, this)" id="btnSize12">
            🚨 QRF Rapid Strike (12 Jawans)
          </button>
          <button class="btn" onclick="setDeployTeamSize(24, this)" id="btnSize24">
            🛡️ Combat Platoon (24 Jawans)
          </button>
          <button class="btn" onclick="setDeployTeamSize(4, this)" id="btnSize4">
            🎯 Recon Section (4 Specialists)
          </button>
        </div>
      </div>

      <!-- Manifest Overview Cards -->
      <div class="emergency-manifest-card" style="margin-top:0;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:12px;">
          <div>
            <div style="font-size:13px;font-weight:900;color:var(--text-heading);" id="manifestTitle">
              Selected Sortie Roster: Top 8 Combat-Eligible Personnel
            </div>
            <div style="font-size:11px;color:var(--muted);" id="manifestSubtitle">
              Filtered from 40 battalion soldiers · 0 fatigued/contraindicated jawans selected.
            </div>
          </div>
          <button class="btn primary emergency-pulse-btn" onclick="regenerateSortieRoster()" style="padding:6px 12px;font-size:11px;">
            ↻ Re-Assess Live Readiness
          </button>
        </div>

        <!-- Telemetry Summary Stats -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:10px;margin-bottom:14px;">
          <div style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:center;">
            <div style="font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:800;">Average Recovery</div>
            <div style="font-size:18px;font-weight:900;color:var(--primary);margin-top:4px;" id="manifestAvgRecovery">88.4%</div>
          </div>
          <div style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:center;">
            <div style="font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:800;">Average SpO2</div>
            <div style="font-size:18px;font-weight:900;color:var(--cyan);margin-top:4px;" id="manifestAvgSpo2">98.2%</div>
          </div>
          <div style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:center;">
            <div style="font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:800;">Sortie Commander</div>
            <div style="font-size:13px;font-weight:900;color:var(--amber);margin-top:4px;" id="manifestLeadOfficer">Major Prafull</div>
          </div>
          <div style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:center;">
            <div style="font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:800;">Physiological Safety</div>
            <div style="font-size:13px;font-weight:900;color:var(--primary);margin-top:4px;">100% Cleared</div>
          </div>
        </div>

        <!-- Selected Soldiers List -->
        <div class="emergency-roster-list" id="emergencyRosterList">
          <!-- Populated by JavaScript -->
        </div>
      </div>

      <!-- Action Buttons -->
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;padding-top:8px;border-top:1px solid var(--line);">
        <button class="btn" onclick="printOrExportManifest()">
          <svg class="icon"><use href="#download"/></svg> Print / Export Tactical Order
        </button>
        <div style="display:flex;gap:8px;">
          <button class="btn" onclick="closeEmergencyDeployModal()">Cancel</button>
          <button class="btn primary emergency-pulse-btn" onclick="dispatchEmergencySortie()">
            ⚡ Authorize &amp; Dispatch Sortie Order
          </button>
        </div>
      </div>
    </div>
  </section>
</div>

