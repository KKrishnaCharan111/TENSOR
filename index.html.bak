        <span>🔥 <b>215</b> CALORIES</span>
        <span><b>TODAY</b></span>
        <span style="color: var(--primary);">🔋 <b>83%</b> BATTERY</span>
      </div>

      <!-- Real WHOOP 3 Rings (Sleep 79%, Recovery 49%, Strain 4.2) -->
      <div class="whoop-rings-row">
        <!-- Ring 1: Sleep -->
        <div class="whoop-ring-box">
          <div style="width: 54px; height: 54px; border-radius: 50%; border: 4px solid #38bdf8; display: grid; place-items: center; margin-bottom: 4px;">
            <span style="font-size: 16px;">🌙</span>
          </div>
          <div class="whoop-ring-val" style="color: #38bdf8;" id="whoopSleepVal">79%</div>
          <div class="whoop-ring-label">SLEEP &gt;</div>
          <div style="font-size: 10px; color: var(--muted); margin-top: 2px;">6:14 hrs</div>
        </div>

        <!-- Ring 2: Recovery -->
        <div class="whoop-ring-box" style="border-color: var(--amber); background: var(--amber-dim);">
          <div style="width: 54px; height: 54px; border-radius: 50%; border: 4px solid #fbbf24; display: grid; place-items: center; margin-bottom: 4px;">
            <span style="font-size: 16px;">⚡</span>
          </div>
          <div class="whoop-ring-val" style="color: #fbbf24;" id="whoopRecoveryVal">49%</div>
          <div class="whoop-ring-label" style="color: #fbbf24;">RECOVERY &gt;</div>
          <div style="font-size: 10px; color: #fbbf24; margin-top: 2px;">Moderate</div>
        </div>

        <!-- Ring 3: Strain -->
        <div class="whoop-ring-box">
          <div style="width: 54px; height: 54px; border-radius: 50%; border: 4px solid #38bdf8; display: grid; place-items: center; margin-bottom: 4px;">
            <span style="font-size: 16px;">📈</span>
          </div>
          <div class="whoop-ring-val" style="color: #38bdf8;" id="whoopStrainVal">4.2</div>
          <div class="whoop-ring-label">STRAIN &gt;</div>
          <div style="font-size: 10px; color: var(--muted); margin-top: 2px;">Zone 0</div>
        </div>
      </div>

      <!-- Real WHOOP Health Monitor (Heart Rate + 5 Metrics from Image 2) -->
      <div class="whoop-app-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <div>
            <div style="font-size: 10px; font-weight: 800; color: var(--muted); letter-spacing: 0.8px; text-transform: uppercase;">HEALTH MONITOR</div>
            <div style="font-size: 26px; font-weight: 900; color: var(--text-heading); margin-top: 2px;">
              <span id="whoopHeartRateVal" style="color: var(--rose);">74</span> <small style="font-size: 13px; color: var(--muted);">BPM</small>
            </div>
          </div>
          <span class="tag green">✓ Within Range (5/5 Metrics)</span>
        </div>

        <!-- 5 Health Tiles -->
        <div class="whoop-metrics-grid">
          <div class="whoop-metric-tile">
            <div class="whoop-metric-head">🫁 RESPIRATORY RATE</div>
            <div class="whoop-metric-big" id="whoopRespVal">18.0 <small style="font-size: 11px; color: var(--muted);">rpm</small></div>
            <div class="whoop-metric-tag">✓ near 17.6</div>
          </div>

          <div class="whoop-metric-tile">
            <div class="whoop-metric-head">💧 BLOOD OXYGEN (SpO2)</div>
            <div class="whoop-metric-big" id="whoopSpo2Val">95%</div>
            <div class="whoop-metric-tag">✓ within 95% - 100%</div>
          </div>

          <div class="whoop-metric-tile">
            <div class="whoop-metric-head">💓 RESTING HEART RATE</div>
            <div class="whoop-metric-big" id="whoopRhrVal">57 <small style="font-size: 11px; color: var(--muted);">bpm</small></div>
            <div class="whoop-metric-tag">✓ within 56 - 59</div>
          </div>

          <div class="whoop-metric-tile">
            <div class="whoop-metric-head">⚡ HRV BASELINE</div>
            <div class="whoop-metric-big" id="whoopHrvVal">65 <small style="font-size: 11px; color: var(--muted);">ms</small></div>
            <div class="whoop-metric-tag">✓ within 65 - 72</div>
          </div>
        </div>

        <div style="margin-top: 10px; padding: 10px 14px; background: var(--card2); border: 1px solid var(--line); border-radius: 12px; display: flex; justify-content: space-between; align-items: center;">
          <div class="whoop-metric-head">🌡️ SKIN TEMP (FROM BASELINE)</div>
          <div style="font-weight: 900; color: var(--text-heading);">+0.4 °C <span class="whoop-metric-tag" style="margin-left: 6px;">✓ near -0.2 to +0.2</span></div>
        </div>
      </div>

      <!-- Universal Bluetooth Connection Panel -->
      <div class="whoop-conn-panel">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <div>
            <div style="font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase;">Universal Bluetooth Telemetry</div>
            <div style="font-size: 14px; font-weight: 900; color: var(--text-heading); margin-top: 2px;" id="bleConnectedDeviceTitle">Any Bluetooth Wearable / WHOOP</div>
          </div>
          <span id="whoopConnStatusBadge" class="tag rose" style="font-weight: 800;">🔴 Not Connected</span>
        </div>

        <!-- Universal Bluetooth Connect Button -->
        <button class="btn primary" onclick="connectRealWhoop()" id="whoopConnectBtn" style="width: 100%; padding: 12px; font-size: 13px; font-weight: 900; background: linear-gradient(135deg, #0284c7, #0d9488); border-color: #38bdf8;">
          <svg class="icon" style="width: 16px; height: 16px;"><use href="#bluetooth"/></svg> Connect Any Bluetooth Device (Pair Wearable)
        </button>

        <!-- Error & Helper Box -->
        <div id="whoopErrorBox" class="whoop-error-box">
          <div style="font-weight: 900; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <span>ℹ️</span> <span id="whoopErrorTitle">Bluetooth Connection Notice</span>
          </div>
          <div id="whoopErrorMessage" style="color: var(--text); font-size: 11px; line-height: 1.5;">
            Ensure Bluetooth is turned ON on your computer. When the browser prompt opens, choose your WHOOP or wearable device to pair.
          </div>
          <button class="btn" style="margin-top: 8px; padding: 5px 12px; font-size: 11px;" onclick="connectRealWhoop()">
            🔄 Scan &amp; Pair Device
          </button>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line-subtle);">
          <span style="font-size: 11px; color: var(--muted);" id="bleTelemetryFooter">Live Bluetooth Telemetry &amp; Vitals</span>
          <button class="whoop-ai-btn" style="padding: 6px 12px; font-size: 11px;" onclick="closeBleModal(); analyzeWhoopWithGemini();">
            ⚡ Analyze with Gemini AI
          </button>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- DIRECT CALL MODAL -->
<div id="callModal" class="backdrop">
  <section class="modal" style="width:min(520px, 95vw);">
    <header class="mhead">
      <div>
        <h2><svg class="icon" style="color:var(--rose)"><use href="#phone"/></svg> Direct Welfare Helpline Dispatch</h2>
        <p>Encrypted, zero-PII voice connection with confidential counselor.</p>
      </div>
      <button class="close" onclick="closeCallModal()">×</button>
    </header>

    <div class="mbody" style="display:flex;flex-direction:column;gap:14px;">
      <div style="padding:12px;border:1px solid var(--primary-border);border-radius:10px;background:var(--primary-dim);font-size:12px;">
        <b style="color:var(--primary)">Strict Anonymity:</b> Your caller ID and unit identity remain private. Calls are handled by non-military certified psychological peers.
      </div>

      <div>
        <label style="font-size:11px;font-weight:800;display:block;margin-bottom:6px">Select Preferred Helpline / Contact:</label>
        <select id="callChoice" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--line);background:var(--card2);color:var(--text)" onchange="onCallChoiceChange()">
          <option value="14416">Tele-MANAS National Helpline — 14416 (Toll-free 24/7)</option>
          <option value="1904">Armed Forces Kavach Welfare Desk — 1904</option>
          <option value="18005990019">KIRAN National Mental Health Line — 1800-599-0019 (Toll-free 24/7)</option>
          <option value="+919999666555">Vandrevala Foundation Peer Line — +91 9999 666 555</option>
          <option value="112">Duty Medical Officer (Emergency Shift Rotation) — 112</option>
          <option value="custom">➕ Enter Custom Number to Connect...</option>
        </select>
      </div>

      <!-- Custom Number Input Form -->
      <div id="customPhoneInputWrap" style="display:none;padding:12px;border:1px solid var(--primary-border);border-radius:10px;background:var(--primary-dim);flex-direction:column;gap:10px;">
        <div>
          <label style="font-size:11px;font-weight:800;color:var(--text-heading);display:block;margin-bottom:4px;">Phone Number to Connect:</label>
          <input id="customPhoneNumber" type="tel" placeholder="e.g. 1800-599-0019 or +91 9876543210" style="width:100%;padding:9px 12px;border-radius:8px;border:1px solid var(--input-border);background:var(--input-bg);color:var(--text);font-size:13px;" oninput="updateCustomCallNumber()">
        </div>
        <div>
          <label style="font-size:11px;font-weight:800;color:var(--text-heading);display:block;margin-bottom:4px;">Contact Label / Name (Optional):</label>
          <input id="customPhoneLabel" type="text" placeholder="e.g. Unit Buddy, Medical Post, Chaplain" style="width:100%;padding:9px 12px;border-radius:8px;border:1px solid var(--input-border);background:var(--input-bg);color:var(--text);font-size:13px;">
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <input type="checkbox" id="saveCustomContactCheck" checked style="accent-color:var(--primary)">
          <label for="saveCustomContactCheck" style="font-size:11px;color:var(--text);cursor:pointer">Save to My Helpline Grid for 1-tap access</label>
        </div>
      </div>

      <div>
        <label style="font-size:11px;font-weight:800;display:block;margin-bottom:6px">Language Selection:</label>
        <select style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--line);background:var(--card2);color:var(--text)">
          <option>Hindi (हिंदी)</option>
          <option>English</option>
          <option>Punjabi (ਪੰਜਾਬੀ)</option>
          <option>Tamil (தமிழ்)</option>
          <option>Telugu (తెలుగు)</option>
          <option>Bengali (বাংলা)</option>
          <option>Marathi (मराठी)</option>
        </select>
      </div>

      <div style="display:flex;align-items:center;gap:10px;padding:10px;border:1px dashed var(--line);border-radius:8px;">
        <input type="checkbox" id="voiceDisguise" checked style="accent-color:var(--primary)">
        <label for="voiceDisguise" style="font-size:11px;cursor:pointer">Enable anonymous frequency scramble for caller voice</label>
      </div>

      <a id="directDialAnchor" href="tel:14416" class="btn primary" style="padding:14px;font-size:14px;font-weight:900;" onclick="handleDirectCall()">
        <svg class="icon"><use href="#phone"/></svg> Connect Call Directly Now
      </a>
    </div>
  </section>
</div>
<!-- MOBILE APP-STYLE BOTTOM NAVIGATION BAR -->
<nav class="mobile-bottom-nav">
  <button class="m-nav-item active" id="mNavHome" onclick="goHome()" title="Home Overview">
    <svg class="m-icon"><use href="#home"/></svg>
    <span>Home</span>
  </button>
  <button class="m-nav-item" id="mNavCommander" onclick="showView('commander')" title="Commander Force Console">
    <svg class="m-icon"><use href="#shield"/></svg>
    <span>Command</span>
  </button>
  <button class="m-nav-item" id="mNavJawan" onclick="showView('jawan')" title="Jawan Confidential Self-Care">
    <svg class="m-icon"><use href="#heart"/></svg>
    <span>Self-Care</span>
  </button>
  <button class="m-nav-item" id="mNavTools" onclick="toggleToolsMenu()" title="Tactical Tools">
    <svg class="m-icon"><use href="#zap"/></svg>
    <span>Tools</span>
  </button>
  <button class="m-nav-item" id="mNavLock" onclick="lockApp()" title="Lock Screen &amp; Biometrics">
    <svg class="m-icon"><use href="#lock"/></svg>
    <span>Lock</span>
  </button>
</nav>

<!-- MOBILE TACTICAL TOOLS BOTTOM SHEET MODAL -->
<div id="toolsSheetBackdrop" class="tools-sheet-backdrop hidden" onclick="closeToolsMenu()">
  <div class="tools-sheet-modal" onclick="event.stopPropagation()">
    <div class="sheet-handle"></div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
      <h3 style="margin:0;font-size:15px;color:var(--text-heading);">Tactical Utilities &amp; Services</h3>
      <button class="btn" style="padding:4px 8px;font-size:11px;" onclick="closeToolsMenu()">✕ Close</button>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px;">
      <button class="tools-menu-item" onclick="open365Calendar(); closeToolsMenu();" style="background:var(--card2);padding:12px;border-radius:12px;">
        <svg class="icon" style="width:20px;height:20px;"><use href="#calendar"/></svg>
        <div><b style="font-size:13px;">365-Day Annual Calendar</b><small style="font-size:11px;">Annual fatigue tracking &amp; roster heatmap</small></div>
      </button>
      <button class="tools-menu-item" onclick="openBleModal(); closeToolsMenu();" style="background:var(--card2);padding:12px;border-radius:12px;">
        <svg class="icon" style="width:20px;height:20px;color:var(--cyan)"><use href="#bluetooth"/></svg>
        <div><b style="font-size:13px;">WHOOP 4.0 BLE GATT</b><small style="font-size:11px;">Connect Bluetooth wearable sensor</small></div>
      </button>
      <button class="tools-menu-item" onclick="toggleGeminiDrawer(); closeToolsMenu();" style="background:var(--card2);padding:12px;border-radius:12px;">
        <svg class="icon" style="width:20px;height:20px;color:#38bdf8"><use href="#spark"/></svg>
        <div><b style="font-size:13px;">Google Gemini AI Assistant</b><small style="font-size:11px;">Operational readiness reasoning</small></div>
      </button>
      <a class="tools-menu-item" href="https://docs.google.com/spreadsheets/d/1smmWEZE4mCpOpP9ntrwO2usq70PGo9uJuNC0neOaQfU/edit?usp=sharing" target="_blank" rel="noopener noreferrer" onclick="closeToolsMenu();" style="background:var(--card2);padding:12px;border-radius:12px;">
        <svg class="icon" style="width:20px;height:20px;color:var(--primary)"><use href="#chart"/></svg>
        <div><b style="font-size:13px;">Google Sheet Live Source</b><small style="font-size:11px;">Open active roster data in Google Sheets ↗</small></div>
      </a>
      <button class="tools-menu-item" onclick="openCallModal(); closeToolsMenu();" style="background:var(--rose-dim);border:1px solid color-mix(in srgb, var(--rose) 40%, var(--line));padding:12px;border-radius:12px;color:var(--rose);">
        <svg class="icon" style="width:20px;height:20px;"><use href="#phone"/></svg>
        <div><b style="font-size:13px;">Emergency Helpline 14416</b><small style="font-size:11px;color:var(--muted)">Tele-MANAS &amp; KIRAN 1800-599-0019</small></div>
      </button>
    </div>
  </div>
</div>

<script>
/* =========================================================================
   TENSOR / KAVACH-AURA — Scripts & 3D Visualizations
   ========================================================================= */

const $ = id => document.getElementById(id);

let currentRole = 'commander';
let audioEnabled = true;
let isDeckStacked = false;
let currentBioType = 'fingerprint';

/* --- Views, Navigation & Mobile Bottom Nav --- */
function showView(view) {
  currentRole = view;
  $('commanderView')?.classList.toggle('hidden', view !== 'commander');
  $('jawanView')?.classList.toggle('hidden', view !== 'jawan');
  $('commanderNav')?.classList.toggle('active', view === 'commander');
  $('jawanNav')?.classList.toggle('active', view === 'jawan');

  // Update mobile bottom nav items
  $('mNavCommander')?.classList.toggle('active', view === 'commander');
  $('mNavJawan')?.classList.toggle('active', view === 'jawan');
  $('mNavHome')?.classList.remove('active');

  window.scrollTo({ top: 0, behavior: 'smooth' });
  if (typeof triggerViewEnterAnimations === 'function') {
    triggerViewEnterAnimations(view);
  }
}

function goHome() {
  window.scrollTo({ top: 0, behavior: 'smooth' });
  $('mNavHome')?.classList.add('active');
  $('mNavCommander')?.classList.remove('active');
  $('mNavJawan')?.classList.remove('active');
  notify('Returned to Dashboard Overview (Top).');
}

function toggleToolsMenu() {
  const isMobile = window.innerWidth <= 768;
  if (isMobile) {
    const sheet = $('toolsSheetBackdrop');
    if (sheet) sheet.classList.toggle('hidden');
  } else {
    const dd = $('toolsMenuDropdown');
    if (dd) dd.classList.toggle('hidden');
  }
}

function closeToolsMenu() {
  $('toolsMenuDropdown')?.classList.add('hidden');
  $('toolsSheetBackdrop')?.classList.add('hidden');
}

/* =========================================================================
   🌐 MULTI-LANGUAGE LOCALIZATION (ENGLISH, HINDI, TELUGU, KANNADA)
   ========================================================================= */
const I18N_LANGUAGES = {
  en: { name: 'English', label: 'English', code: 'EN' },
  hi: { name: 'हिन्दी', label: 'हिन्दी (Hindi)', code: 'HI' },
  te: { name: 'తెలుగు', label: 'తెలుగు (Telugu)', code: 'TE' },
  kn: { name: 'ಕನ್ನಡ', label: 'ಕನ್ನಡ (Kannada)', code: 'KN' }
};

let currentLanguage = localStorage.getItem('kavach_lang') || 'en';

const I18N_TRANSLATIONS = {
