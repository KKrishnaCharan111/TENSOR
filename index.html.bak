    btn_gateway_network: 'वूप गेटवे नेटवर्क (40)',
    btn_add_personnel: '+ जवान जोड़ें',

    // KPIs
    kpi_tag_optimal: 'युद्ध अनुकूल',
    kpi_readiness_label: 'बटालियन युद्ध तत्परता',
    kpi_connected_label: 'कनेक्टेड वूप क्षमता',
    kpi_tier1_tag: 'युद्ध श्रेणी 1',
    kpi_prebattle_label: 'लड़ाई हेतु पूर्ण तैयार',
    kpi_fatigue_tag: 'थकान जोखिम',
    kpi_fatigue_label: 'थकान के कारण प्रतिबंधित',
    kpi_fatigue_sub: 'हताहतों की रोकथाम हेतु गैर-तैनाती योग्य',

    // Jawan view
    jawan_eyebrow: 'आपके लिए गोपनीय और सुरक्षित',
    jawan_title: 'मेरी गोपनीय आत्म-देखभाल',
    jawan_subtitle: 'आपकी व्यक्तिगत रिकवरी टेलीमेट्री। अधिकारियों या सेवा रिकॉर्ड के लिए कभी सुलभ नहीं।',
    btn_connect_whoop: 'मेरा वूप कनेक्ट करें',
    btn_helplines: 'हेल्पलाइन',
