    <article class="panel" id="secBreathing">
      <header class="head">
        <div>
          <h2 data-i18n="breath_panel_title">Tactical Box Breathing (Grounding)</h2>
          <p data-i18n="breath_panel_sub">2-minute tactical breath regulator for operational focus.</p>
        </div>
      </header>
      <div class="breath">
        <div class="orbwrap" style="width:100%;padding:0;">
          <!-- SPEC 2: Box Breathing Waveform Graph (Matching User Image Specification) -->
          <div class="box-wave-card" id="tacticalBreathBox" onclick="toggleBreathing()" title="Click to start, pause, or resume Box Breathing">
            <div class="box-wave-head">
              <div>
                <div class="box-wave-title" data-i18n="box_wave_title">Box breathing</div>
                <div class="box-wave-sub" data-i18n="box_wave_sub">Focus &amp; composure</div>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <span class="box-wave-phase-badge" id="boxWaveBadge">
                  <span class="status-pulse-dot" style="width:6px;height:6px;"></span>
                  <span id="boxWaveBadgeTxt">INHALE (0-4s)</span>
                </span>
                <span style="color:var(--cyan);cursor:pointer;" title="Tap to toggle tutorial details">
                  <svg class="icon" style="width:16px;height:16px;"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </div>
            </div>

            <!-- Sleek Top Accent Divider Bar -->
            <div class="box-wave-divider" id="boxWaveDivider"></div>

            <!-- Waveform SVG with Time Curve 0, 4, 8, 12, 16, 20, 24, 28 -->
            <div class="box-wave-canvas-wrap">
              <svg class="box-wave-svg" viewBox="0 0 560 120" preserveAspectRatio="none">
                <defs>
                  <!-- Active Gradient Fill under Wave -->
                  <linearGradient id="boxWaveGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="var(--primary)" stop-opacity="0.45" id="waveGradStop0" />
                    <stop offset="100%" stop-color="var(--primary)" stop-opacity="0.02" id="waveGradStop1" />
                  </linearGradient>
                  <!-- Glow filter for laser tracer dot -->
                  <filter id="waveDotGlow" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur stdDeviation="3" result="glow" />
                    <feMerge>
                      <feMergeNode in="glow" />
                      <feMergeNode in="SourceGraphic" />
                    </feMerge>
                  </filter>
                </defs>

                <!-- Baseline Horizontal Axis & Vertical Left Axis Bar -->
                <line x1="20" y1="88" x2="540" y2="88" class="box-wave-axis" />
                <line x1="20" y1="34" x2="20" y2="88" class="box-wave-axis" stroke-width="2" />

                <!-- Timeline Grid Vertical Lines -->
                <!-- 0s: x=20 -->
                <line x1="20" y1="40" x2="20" y2="88" class="box-wave-grid-tick" />
                <!-- 4s: x=90 -->
                <line x1="90" y1="28" x2="90" y2="88" class="box-wave-grid-tick" />
                <!-- 8s: x=160 -->
                <line x1="160" y1="28" x2="160" y2="88" class="box-wave-grid-tick" />
                <!-- 12s: x=230 -->
                <line x1="230" y1="40" x2="230" y2="88" class="box-wave-grid-tick" />
                <!-- 16s: x=300 -->
                <line x1="300" y1="40" x2="300" y2="88" class="box-wave-grid-tick" />
                <!-- 20s: x=370 -->
                <line x1="370" y1="28" x2="370" y2="88" class="box-wave-grid-tick" />
                <!-- 24s: x=440 -->
                <line x1="440" y1="28" x2="440" y2="88" class="box-wave-grid-tick" />
                <!-- 28s: x=510 -->
                <line x1="510" y1="40" x2="510" y2="88" class="box-wave-grid-tick" />

                <!-- Timeline Numeric Labels (0, 4, 8, 12, 16, 20, 24, 28) -->
                <text x="20" y="106" class="box-wave-tick-text active-cycle" id="tick0">0</text>
                <text x="90" y="106" class="box-wave-tick-text active-cycle" id="tick4">4</text>
                <text x="160" y="106" class="box-wave-tick-text active-cycle" id="tick8">8</text>
                <text x="230" y="106" class="box-wave-tick-text active-cycle" id="tick12">12</text>
                <text x="300" y="106" class="box-wave-tick-text active-cycle" id="tick16">16</text>
                <text x="370" y="106" class="box-wave-tick-text" id="tick20">20</text>
                <text x="440" y="106" class="box-wave-tick-text" id="tick24">24</text>
                <text x="510" y="106" class="box-wave-tick-text" id="tick28">28</text>

                <!-- Cycle 2 (Muted Grey Cycle 16s-32s in Background) -->
                <polygon points="300,88 320,88 350,34 440,34 470,88 510,88 540,88 540,88 300,88" class="box-wave-bg-fill" />
                <path d="M300,88 C315,88 335,88 345,62 C355,34 365,34 380,34 L430,34 C445,34 455,34 465,62 C475,88 495,88 510,88 L540,88" class="box-wave-bg-path" />

                <!-- Cycle 1 Active Curved Trapezoid Area (Inhale -> Hold -> Exhale -> Hold) -->
                <polygon id="waveActivePolygon" points="20,88 20,88 35,88 65,34 160,34 190,88 230,88 300,88 300,88 20,88" class="box-wave-active-fill" />
                <path id="waveActivePath" d="M20,88 C32,88 55,88 68,60 C78,34 88,34 100,34 L150,34 C162,34 172,34 182,60 C195,88 215,88 230,88 L300,88" class="box-wave-active-stroke" />

                <!-- Live Animated Indicator Dot moving along trapezoid curve -->
                <circle id="waveTracerDot" cx="20" cy="88" r="6" class="box-wave-tracer-dot" filter="url(#waveDotGlow)" />
              </svg>
            </div>

            <!-- Footer Tutorial Callout (Matching User Image Spec) -->
            <div class="box-wave-footer">
              <a class="box-wave-tutorial-link" onclick="event.stopPropagation();setBreathingProtocol('box');" title="Guided breathwork tutorial & vagal grounding drills">
                <span>Tutorial</span>
                <svg class="icon" style="width:12px;height:12px;"><use href="#zap"/></svg>
              </a>
              <div style="font-size:11px;font-weight:800;color:var(--muted);">
                Phase: <b id="tbbPhase" style="color:var(--primary);">READY</b> · <span id="tbbCount" style="color:var(--text-heading);font-family:monospace;">TAP TO START</span>
              </div>
            </div>
          </div>
        </div>
        <div class="breathside">
          <!-- Status Pill & Digital Timer Card -->
          <div class="breath-header-row">
            <div class="breath-status-pill" id="breathStatusPill">
              <span class="status-pulse-dot"></span>
              <span id="breathHint">One calming 4-4-4-4 cycle</span>
            </div>
            <div class="breath-digital-clock">
              <span class="clock-label">TIME REMAINING</span>
              <b id="timer">02:00</b>
            </div>
          </div>

          <!-- Progress Bar with milestone ticks -->
          <div class="progress-wrap">
            <div class="progress"><i id="progress"></i></div>
          </div>

          <!-- 4-Phase Stepper with Step Numbers and Seconds -->
          <div id="phases" class="phases">
            <div class="phase-box active" data-phase="0">
              <span class="phase-num">STEP 1</span>
              <b class="phase-name">INHALE</b>
              <small class="phase-dur">4s</small>
            </div>
            <div class="phase-box" data-phase="1">
              <span class="phase-num">STEP 2</span>
              <b class="phase-name">HOLD</b>
              <small class="phase-dur">4s</small>
            </div>
            <div class="phase-box" data-phase="2">
              <span class="phase-num">STEP 3</span>
              <b class="phase-name">EXHALE</b>
              <small class="phase-dur">4s</small>
            </div>
            <div class="phase-box" data-phase="3">
              <span class="phase-num">STEP 4</span>
              <b class="phase-name">HOLD</b>
              <small class="phase-dur">4s</small>
            </div>
          </div>

          <!-- Control Actions Row -->
          <div class="breath-ctrl-row">
            <button id="breathActionBtn" class="btn primary breath-start-btn" onclick="toggleBreathing()">
              <svg class="icon"><use href="#zap"/></svg> <span id="breathBtnText">Start Breathing Cycle</span>
            </button>
            <button class="btn breath-reset-btn" onclick="resetBreathing()" title="Reset session back to 02:00">
              <svg class="icon"><use href="#rotate"/></svg> <span>Reset</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Tactical Grounding Drills & Science (Eliminates Empty Space) -->
      <div class="breath-grounding-suite">
        <div class="grounding-protocols-row">
          <span style="font-size:10px;font-weight:800;color:var(--muted);text-transform:uppercase;margin-right:2px;">Protocol:</span>
          <button class="protocol-chip active" id="protoBox" onclick="setBreathingProtocol('box', this)">4-4-4-4 Box Drill</button>
          <button class="protocol-chip" id="protoSleep" onclick="setBreathingProtocol('sleep', this)">4-7-8 Sleep Drill</button>
          <button class="protocol-chip" id="protoSigh" onclick="setBreathingProtocol('sigh', this)">Double Sigh</button>
        </div>

        <div class="grounding-science-box">
          <div class="science-item">
            <svg class="icon" style="color:var(--primary);width:14px;height:14px;flex:none;"><use href="#zap"/></svg>
            <div>
              <b>Vagal Parasympathetic Tone:</b>
              <span>Stimulates vagus nerve, dropping sympathetic pulse by 6–10 BPM within 90s.</span>
            </div>
          </div>
          <div class="science-item">
            <svg class="icon" style="color:var(--cyan);width:14px;height:14px;flex:none;"><use href="#shield"/></svg>
            <div>
              <b>Prefrontal Focus Recovery:</b>
              <span>Counteracts cognitive tunnel vision and stabilizes operational decision-making.</span>
            </div>
          </div>
        </div>

        <div class="grounding-stats-strip">
          <div class="g-stat">
            <span class="g-stat-label">Today's Drills</span>
            <b class="g-stat-val">2 Sessions</b>
          </div>
          <div class="g-stat">
            <span class="g-stat-label">Mindful Duration</span>
            <b class="g-stat-val">4m 00s</b>
          </div>
          <div class="g-stat">
            <span class="g-stat-label">Daily Goal</span>
            <b class="g-stat-val" style="color:var(--primary)">6m (66%)</b>
          </div>
        </div>
      </div>
    </article>
  </section>
</main>

<footer class="app" style="display:flex;justify-content:space-between;padding:24px 0 28px;color:var(--muted);font-size:11px;">
