<!-- WHOOP 4.0 BLUETOOTH GATT MANAGER MODAL (AUTHENTIC WHOOP INTERFACE) -->
<div id="bleModal" class="backdrop">
  <section class="modal" style="width: min(620px, 95vw); max-height: 94vh; overflow-y: auto; padding: 22px; background: var(--card); border: 1px solid var(--line); color: var(--text);">
    <header class="mhead" style="margin-bottom: 16px;">
