<!-- ADD PERSONNEL / PAIR WHOOP BAND MODAL -->
<div id="addSoldierModal" class="backdrop">
  <section class="modal" style="width:min(520px, 95vw);">
    <header class="mhead">
      <div>
        <h2><svg class="icon" style="color:var(--primary)"><use href="#users"/></svg> Enroll Personnel &amp; Pair WHOOP Band</h2>
        <p>Register a combatant into the battalion roster and assign an active WHOOP device.</p>
      </div>
      <button class="close" onclick="closeAddSoldierModal()">×</button>
    </header>

    <form class="mbody" style="display:flex;flex-direction:column;gap:12px;" onsubmit="handleAddNewSoldier(event)">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <label style="font-size:11px;font-weight:800;color:var(--text-heading);">
          Service / KV ID
          <input id="newSoldierId" required placeholder="e.g. KV-141" style="width:100%;margin-top:4px;padding:8px;border-radius:6px;border:1px solid var(--input-border);background:var(--input-bg);color:var(--text);" />
        </label>
        <label style="font-size:11px;font-weight:800;color:var(--text-heading);">
          Military Rank
          <select id="newSoldierRank" style="width:100%;margin-top:4px;padding:8px;border-radius:6px;border:1px solid var(--input-border);background:var(--input-bg);color:var(--text);">
            <option value="Sepoy">Sepoy</option>
            <option value="Naik">Naik</option>
            <option value="Havildar">Havildar</option>
            <option value="Subedar">Subedar</option>
            <option value="Lt.">Lieutenant (Lt.)</option>
            <option value="Captain">Captain</option>
            <option value="Major">Major</option>
          </select>
        </label>
      </div>

      <label style="font-size:11px;font-weight:800;color:var(--text-heading);">
        Full Name
        <input id="newSoldierName" required placeholder="e.g. Havildar Gurpreet Gill" style="width:100%;margin-top:4px;padding:8px;border-radius:6px;border:1px solid var(--input-border);background:var(--input-bg);color:var(--text);" />
      </label>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <label style="font-size:11px;font-weight:800;color:var(--text-heading);">
          Assigned Company
          <select id="newSoldierCompany" style="width:100%;margin-top:4px;padding:8px;border-radius:6px;border:1px solid var(--input-border);background:var(--input-bg);color:var(--text);">
            <option value="Alpha Assault">Alpha Assault Co</option>
            <option value="Bravo Recon">Bravo Recon Co</option>
            <option value="Charlie Strike">Charlie Strike Co</option>
            <option value="Delta Support">Delta Support Co</option>
            <option value="QRF Strike">QRF Quick Reaction</option>
          </select>
        </label>
        <label style="font-size:11px;font-weight:800;color:var(--text-heading);">
          Tactical Specialty / Role
          <input id="newSoldierRole" placeholder="e.g. Combat Breacher" style="width:100%;margin-top:4px;padding:8px;border-radius:6px;border:1px solid var(--input-border);background:var(--input-bg);color:var(--text);" />
        </label>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <label style="font-size:11px;font-weight:800;color:var(--text-heading);">
          WHOOP Band ID
          <input id="newSoldierWhoop" required placeholder="e.g. WP-4-ALP-09" style="width:100%;margin-top:4px;padding:8px;border-radius:6px;border:1px solid var(--input-border);background:var(--input-bg);color:var(--text);" />
        </label>
        <label style="font-size:11px;font-weight:800;color:var(--text-heading);">
          Baseline Recovery (%)
          <input id="newSoldierRecovery" type="number" min="1" max="100" value="82" style="width:100%;margin-top:4px;padding:8px;border-radius:6px;border:1px solid var(--input-border);background:var(--input-bg);color:var(--text);" />
        </label>
      </div>

      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:8px;">
        <button class="btn" type="button" onclick="closeAddSoldierModal()">Cancel</button>
        <button class="btn primary" type="submit">Enroll &amp; Pair</button>
      </div>
    </form>
  </section>
</div>

