  </header>

    <!-- Quick Action Prompt Chips & WHOOP Analysis -->
  <div style="padding:10px 20px 4px;border-top:1px solid var(--line-subtle);background:color-mix(in srgb, var(--bg) 50%, var(--card));display:flex;align-items:center;justify-content:space-between;">
    <span style="font-size:10px;font-weight:900;color:var(--cyan);text-transform:uppercase;">✦ AI Telemetry Actions &amp; Suggestions:</span>
    <button class="whoop-ai-btn" style="padding:4px 10px;font-size:10px;" onclick="analyzeWhoopWithGemini()">
      <svg class="icon" style="width:12px;height:12px"><use href="#spark"/></svg> Run Live WHOOP Analysis
    </button>
  </div>
  <div class="gemini-quick-prompts">
    <button class="gemini-chip" onclick="analyzeWhoopWithGemini()">⚡ Analyze Live WHOOP (BPM + HRV + Recovery)</button>
    <button class="gemini-chip" onclick="askGeminiPrompt('Analyze 365-day annual fatigue trends and highlight peak strain periods.')">📅 365-Day Fatigue Trends</button>
    <button class="gemini-chip" onclick="askGeminiPrompt('Recommend ethical tactical rotation and rest shift for Naik Gurdeep Singh (KV-107: 4.2h sleep, SpO2 93%, Readiness 46).')">🛡️ KV-107 Rotation Plan</button>
    <button class="gemini-chip" onclick="askGeminiPrompt('Explain physiological causes of acute resting HRV baseline dips and best recovery protocols.')">🩺 HRV Dip Recovery</button>
    <button class="gemini-chip" onclick="askGeminiPrompt('Provide tactical 4-4-4-4 box breathing and circadian guidance for night perimeter shifts.')">🧘 Night Shift Circadian</button>
    <button class="gemini-chip" onclick="askGeminiPrompt('How does confidential Tele-MANAS (14416), Kavach (1904), and KIRAN (1800-599-0019) support work with zero-PII protection?')">📞 Helplines &amp; Anonymity</button>
  </div>

  <!-- Chat History -->
  <div id="geminiChatBody" class="gemini-chat-body">
    <div class="gemini-msg assistant">
      <b>Hello! I am your TENSOR Welfare AI Co-Pilot powered by Google Gemini.</b><br><br>
      I monitor anonymized cohort trends, resting HRV baselines, circadian sleep debt, and ethical rotation windows without storing raw personal credentials.<br><br>
      How can I assist you with unit welfare or recovery today?
    </div>
    <div id="geminiTypingIndicator" class="gemini-typing">
      <div class="typing-dots"><span></span><span></span><span></span></div>
      <span>Gemini is generating response...</span>
    </div>
  </div>

  <!-- Chat Input Bar -->
  <form class="gemini-input-bar" onsubmit="handleGeminiSubmit(event)">
    <input id="geminiInput" autocomplete="off" placeholder="Ask Gemini about welfare, HRV recovery, rotation..." />
    <button class="btn primary" type="submit" style="padding:10px 16px;">Send</button>
  </form>
</aside>

<!-- GEMINI API KEY CONFIG MODAL -->
<div id="geminiKeyModal" class="backdrop">
  <section class="modal" style="width:min(520px, 95vw);">
