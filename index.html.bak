      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(110px, 1fr));gap:8px;">
        <div style="background:var(--card2);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:center;">
          <div style="font-size:10px;color:var(--muted);font-weight:800;">RECOVERY</div>
          <div style="font-size:18px;font-weight:900;color:var(--primary);margin-top:2px;" id="dossierRecoveryVal">88%</div>
        </div>
        <div style="background:var(--card2);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:center;">
          <div style="font-size:10px;color:var(--muted);font-weight:800;">RESTING HRV</div>
          <div style="font-size:18px;font-weight:900;color:var(--cyan);margin-top:2px;" id="dossierHrvVal">74 ms</div>
        </div>
        <div style="background:var(--card2);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:center;">
          <div style="font-size:10px;color:var(--muted);font-weight:800;">SLEEP DEBT</div>
          <div style="font-size:18px;font-weight:900;color:var(--text);margin-top:2px;" id="dossierSleepDebtVal">0.4h</div>
        </div>
        <div style="background:var(--card2);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:center;">
          <div style="font-size:10px;color:var(--muted);font-weight:800;">SpO2 LEVEL</div>
          <div style="font-size:18px;font-weight:900;color:var(--primary);margin-top:2px;" id="dossierSpo2Val">98%</div>
        </div>
        <div style="background:var(--card2);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:center;">
          <div style="font-size:10px;color:var(--muted);font-weight:800;">DAILY STRAIN</div>
          <div style="font-size:18px;font-weight:900;color:var(--amber);margin-top:2px;" id="dossierStrainVal">11.2</div>
        </div>
      </div>

      <!-- AI Clinical Justification Card -->
      <div style="background:var(--card2);border:1px solid var(--line);border-radius:10px;padding:14px;">
        <div style="font-size:11px;font-weight:900;color:var(--cyan);text-transform:uppercase;margin-bottom:6px;display:flex;align-items:center;gap:6px;">
          <svg class="icon" style="width:13px;height:13px;"><use href="#spark"/></svg> AI Physiological War Clearance Assessment &amp; Clinical "Why":
        </div>
        <div id="dossierAiReasonContent" style="font-size:12px;line-height:1.65;color:var(--text);">
          <!-- Populated by JS -->
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;">
        <button class="btn" onclick="downloadSingleSoldierReport()">
          <svg class="icon"><use href="#download"/></svg> Export Dossier
        </button>
        <button class="btn primary" onclick="closeSoldierAiDossierModal()">Close Dossier</button>
      </div>
    </div>
  </section>
</div>

</body>
</html>
